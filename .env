HTTPX_CLIENT.BASE_URL='http://localhost:8000'
HTTPX_CLIENT.TIMEOUT=5.0

TEST_DATA.IMAGE_PNG_FILE='testdata/files/test_image.png'

#------------------------------------- Swagger Coverage Tool (Requirements coverage) -------------------------------------
# List of services for which coverage will be measured
SWAGGER_COVERAGE_SERVICES='[
    {
        "key": "api-service",
        "name": "API Service",
        "tags": ["API", "PRODUCTION"],
        "repository": "https://github.com/Vitaly-Miller/autotests-api-httpx",
        "swagger_url": "http://localhost:8000/openapi.json"
    }
]'
# Settings (optional)                                       # (If not needed at all - ...=null)
SWAGGER_COVERAGE_RESULTS_DIR='coverage-results'             # Folder for intermediate coverage JSON files
SWAGGER_COVERAGE_HISTORY_FILE='coverage-history.json'       # File with coverage history per run
SWAGGER_COVERAGE_HISTORY_RETENTION_LIMIT=30                 # Limit on number of stored history records (for trend report)
SWAGGER_COVERAGE_HTML_REPORT_FILE='coverage.html'           # index.html (dafault) —> coverage.html (custom)
SWAGGER_COVERAGE_JSON_REPORT_FILE='coverage-report.json'    # Path to final JSON report (for integrations and CI)

#-----------------------------------------------------------------------------------------------------------------------
